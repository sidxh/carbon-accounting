# ---- Gemini -------------------------------------------------------------
# Zero-payment mode: an AI Studio key (15 requests a minute). The deployed agent runs on Vertex AI instead
# (infra/deploy.sh sets it). To try Vertex locally: `gcloud auth application-default login`, then set
# GOOGLE_GENAI_USE_VERTEXAI=TRUE, GOOGLE_CLOUD_PROJECT=<project>, GOOGLE_CLOUD_LOCATION=global and
# GEMINI_RPM=120. Nothing else changes.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Default model for extraction / reconciliation / drafting. Only Gemini 3.x IDs.
GEMINI_MODEL=gemini-3.5-flash-lite
# Free-tier quota for the model above, as shown in AI Studio for this project.
GEMINI_RPM=15
GEMINI_RPD=500
# On-disk response cache so re-running the golden set costs no quota.
GEMINI_CACHE_DIR=.cache/gemini

# ---- Firebase / storage -------------------------------------------------
FIREBASE_PROJECT_ID=fir-testing-f96b1
# Point the Admin SDK at the local emulators (leave unset in production).
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# "local" writes documents to agent/.local_storage; "gcs" uses the bucket below.
STORAGE_BACKEND=local
STORAGE_BUCKET=fir-testing-f96b1.appspot.com

# ---- API ------------------------------------------------------------------
# Set to TRUE to skip Firebase ID-token verification in local dev only.
AUTH_DISABLED=FALSE
CORS_ORIGINS=http://localhost:3000
