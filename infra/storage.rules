rules_version = '2';

// Suppliers upload bills into their own prefix and can read them back.
// Generated outputs (filled workbooks, methodology PDFs) are written by the
// agent service and served to the owner through signed URLs.
service firebase.storage {
  match /b/{bucket}/o {
    match /suppliers/{supplierId}/uploads/{fileName} {
      allow read: if request.auth != null && request.auth.uid == supplierId;
      allow write: if request.auth != null
        && request.auth.uid == supplierId
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
    }
    match /suppliers/{supplierId}/outputs/{fileName} {
      allow read: if request.auth != null && request.auth.uid == supplierId;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
